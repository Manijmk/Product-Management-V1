NODE_ENV=development
APP_PORT=4000
APP_NAME=pms-backend
POSTGRES_PORT=5432

DATABASE_URL=postgresql://pms_runtime:CHANGE_ME@localhost:5432/pms
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/pms
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_RUNTIME_ROLE=pms_app
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=pms-backend
AUTH_JWT_AUDIENCE=pms-api
# Optional: provisions the UAT owner credential when running db:seed:uat.
UAT_SEED_PASSWORD=

LOG_LEVEL=info

SWAGGER_ENABLED=true
